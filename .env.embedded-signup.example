# ============================================================================
# Variables de entorno — Embedded Signup de WhatsApp Business
# ============================================================================
# Estas variables son necesarias para que el flow de "Conectar con Facebook"
# funcione. Si NO están definidas, el botón aparece deshabilitado.
# ============================================================================

# ─── Meta (Facebook Business / WhatsApp) ──────────────────────────────────

# App ID público de tu Meta App
# Lo encuentras en: developers.facebook.com → tu App → Settings → Basic → App ID
# IMPORTANTE: prefijo NEXT_PUBLIC_ porque se usa en el frontend (no es secreto)
NEXT_PUBLIC_META_APP_ID=1234567890123456

# App Secret de tu Meta App
# Lo encuentras en: developers.facebook.com → tu App → Settings → Basic → App Secret
# CRITICO: sin prefijo NEXT_PUBLIC_ porque es SECRETO. NUNCA exponerlo al frontend.
META_APP_SECRET=abc123...

# Config ID de Facebook Login for Business
# Lo creas en: developers.facebook.com → tu App → Facebook Login for Business → Configurations
# Debe ser tipo "Embedded Signup"
NEXT_PUBLIC_META_CONFIG_ID=1122334455667788

# Verify token del webhook (string secreto que tú inventas y configuras en Meta)
# Cuando Meta verifica tu webhook, manda este token y debes responder con él
META_WEBHOOK_VERIFY_TOKEN=mi_token_super_secreto_2026

# Versión del Graph API
# Recomendado: la más reciente. Actualizar trimestralmente.
META_GRAPH_VERSION=v22.0

# ─── Supabase (ya las tienes, las repito para referencia) ─────────────────

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
