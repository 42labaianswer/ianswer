# ── IA: Anthropic (modelo premium, opcional - usado por addon ai_premium) ─
# ANTHROPIC_API_KEY=sk-ant-...

# ── Resend (envío de correos: recuperación de contraseña, verificación de
#    correo al registrarse, facturas, recordatorios) ────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=iAnswer <no-responder@ianswer.pro>
# EMAIL_REPLY_TO=soporte@ianswer.pro

# ── App URL (para enlaces absolutos en emails, webhooks Meta, etc.) ──────
